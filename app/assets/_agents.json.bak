{
  "version": 1,
  "note": "★ Agent 登记册（唯一来源）。谁在跑、配什么配件、有哪些能力、配置/日志在哪。新增 agent 只改本文件，不改代码。",
  "schema": {
    "label": "显示名",
    "enabled": "用户开关：false = 完全忽略该 agent（不探测、不配配件）",
    "verified": "本机是否实测验证过（false 的项属于『已知但未验证』，需自行确认路径/进程名）",
    "order": "看板/菜单里的排序",
    "accessory": "活跃时古见佩戴的配件 kind（见 wb_accessories.KINDS）；null = 只显示在数据里，不佩戴",
    "accent": "身份色（预留：徽章/领结用）",
    "caps": {
      "log": "★有解析器能读用量 → 看板有数据",
      "presence": "★能探测『正在运行』 → 能驱动配件",
      "hooks": "是否有事件回调能力（我们暂未实现；Clawd 走的是这条路）"
    },
    "presence": "活跃探针：procs=进程名精确匹配；ports=本机监听端口（web 型 agent 用）",
    "config_paths": "该 agent 的配置文件位置（情报备查，供将来做『一键接入 hooks』用）",
    "log_paths": "会话/用量日志位置（对应 agents/ 里的数据源实现）",
    "notes": "限制与坑"
  },
  "agents": {
    "workbuddy": {
      "label": "WorkBuddy",
      "enabled": true,
      "verified": true,
      "order": 10,
      "accessory": "cat",
      "accent": "#F2A0AE",
      "caps": {
        "log": true,
        "presence": true,
        "hooks": false
      },
      "presence": {
        "procs": [
          "WorkBuddy.exe"
        ],
        "ports": []
      },
      "config_paths": [
        "~/.workbuddy/settings.json",
        "~/.workbuddy-ai/settings.json"
      ],
      "log_paths": [
        "~/.workbuddy/projects/*/*.jsonl"
      ],
      "notes": "有独立 GUI 进程 → 进程探测可靠。Clawd 支持它的 Notification hook（仅状态、无权限审批），我们只用日志+进程。"
    },
    "zcode": {
      "label": "ZCode",
      "enabled": true,
      "verified": true,
      "order": 15,
      "accessory": "beret",
      "accent": "#39406B",
      "caps": {
        "log": true,
        "presence": true,
        "hooks": false
      },
      "presence": {
        "procs": [
          "ZCode.exe"
        ],
        "ports": []
      },
      "config_paths": [
        "~/.zcode/cli/config.json"
      ],
      "log_paths": [
        "~/.zcode/cli/db/db.sqlite"
      ],
      "notes": "Electron 应用，进程探测可靠。Clawd 经 config.json 的 hooks.events.* 接入（支持阻塞式权限审批）；本项目改为读它的 SQLite，不写它的配置。"
    },
    "deepseek-harness": {
      "label": "DeepSeek Harness",
      "enabled": true,
      "verified": true,
      "order": 25,
      "accessory": "whale_plush",
      "accent": "#5B7CFA",
      "caps": {
        "log": true,
        "presence": true,
        "hooks": false
      },
      "presence": {
        "procs": [],
        "ports": [
          3080
        ]
      },
      "config_paths": [
        "~/.dsh/settings.yaml"
      ],
      "log_paths": [
        "~/.dsh/sessions/**/session*.jsonl.zstd"
      ],
      "notes": "无独立窗口（node 起的 web 服务）→ 只能按端口 3080 探测。日志是 zstd 压缩流，见 wb_usage/zstdio.py。Clawd 为它写了独立插件且把版本钉死到 =0.1.1-rc.2 + 产物哈希校验 —— 说明其插件接口很脆，我们不碰它反而更稳。"
    },
    "codex": {
      "label": "Codex CLI",
      "enabled": true,
      "verified": true,
      "order": 30,
      "accessory": null,
      "accent": "#10A37F",
      "caps": {
        "log": true,
        "presence": false,
        "hooks": false
      },
      "presence": {
        "procs": [],
        "ports": []
      },
      "config_paths": [
        "~/.codex/config.toml"
      ],
      "log_paths": [
        "~/.codex/sessions/**/rollout-*.jsonl"
      ],
      "notes": "用量数据可用（文件源）。**没有活跃探针** → 不会驱动配件。CLI 类 agent 寄生在 node.exe 上，靠进程名判断『在跑』不可靠，这也是 Clawd 用 hooks 的原因。"
    },
    "claude-code": {
      "label": "Claude Code",
      "enabled": false,
      "verified": false,
      "order": 40,
      "accessory": null,
      "accent": "#D97757",
      "caps": {
        "log": false,
        "presence": false,
        "hooks": true
      },
      "presence": {
        "procs": [],
        "ports": []
      },
      "config_paths": [
        "~/.claude/settings.json"
      ],
      "log_paths": [
        "~/.claude/projects/*/*.jsonl"
      ],
      "notes": "【未验证】有成熟 hooks（Clawd 覆盖 15 个事件）。本机未确认安装，故默认关闭。数据源可参考 ccusage（MIT）实现。"
    },
    "gemini-cli": {
      "label": "Gemini CLI",
      "enabled": false,
      "verified": false,
      "order": 50,
      "accessory": null,
      "accent": "#4285F4",
      "caps": {
        "log": false,
        "presence": false,
        "hooks": true
      },
      "presence": {
        "procs": [],
        "ports": []
      },
      "config_paths": [
        "~/.gemini/settings.json"
      ],
      "log_paths": [],
      "notes": "【未验证】hooks 写在 ~/.gemini/settings.json。"
    },
    "qwen-code": {
      "label": "Qwen Code",
      "enabled": false,
      "verified": false,
      "order": 55,
      "accessory": null,
      "accent": "#615CED",
      "caps": {
        "log": false,
        "presence": false,
        "hooks": true
      },
      "presence": {
        "procs": [],
        "ports": []
      },
      "config_paths": [
        "~/.qwen/settings.json"
      ],
      "log_paths": [],
      "notes": "【未验证】Clawd 支持其 PermissionRequest 桌面审批气泡。"
    },
    "kimi": {
      "label": "Kimi Code",
      "enabled": false,
      "verified": false,
      "order": 60,
      "accessory": null,
      "accent": "#0B0B0B",
      "caps": {
        "log": false,
        "presence": false,
        "hooks": true
      },
      "presence": {
        "procs": [],
        "ports": []
      },
      "config_paths": [
        "~/.kimi/config.toml"
      ],
      "log_paths": [],
      "notes": "【未验证】hooks 写成 config.toml 的 [[hooks]] 条目。"
    },
    "cursor": {
      "label": "Cursor",
      "enabled": false,
      "verified": false,
      "order": 65,
      "accessory": null,
      "accent": "#6E56CF",
      "caps": {
        "log": false,
        "presence": false,
        "hooks": true
      },
      "presence": {
        "procs": [
          "Cursor.exe"
        ],
        "ports": []
      },
      "config_paths": [
        "~/.cursor/hooks.json"
      ],
      "log_paths": [],
      "notes": "【未验证】IDE 型，有独立进程（进程名大概率可靠）。"
    },
    "opencode": {
      "label": "opencode",
      "enabled": false,
      "verified": false,
      "order": 70,
      "accessory": null,
      "accent": "#6B7280",
      "caps": {
        "log": false,
        "presence": false,
        "hooks": true
      },
      "presence": {
        "procs": [],
        "ports": []
      },
      "config_paths": [
        "~/.config/opencode/"
      ],
      "log_paths": [],
      "notes": "【未验证】走插件机制（~/.config/opencode/ 下）。"
    },
    "codebuddy": {
      "label": "CodeBuddy",
      "enabled": false,
      "verified": false,
      "order": 75,
      "accessory": null,
      "accent": "#2E7DF6",
      "caps": {
        "log": false,
        "presence": true,
        "hooks": true
      },
      "presence": {
        "procs": [
          "CodeBuddy.exe"
        ],
        "ports": []
      },
      "config_paths": [
        "~/.codebuddy/settings.json"
      ],
      "log_paths": [],
      "notes": "【未验证】配置文件格式兼容 Claude Code。"
    }
  },
  "disabled_note": "enabled=false 的项属于『已知但未验证』：路径与能力来自对同类项目的调研（主要参考 Clawd on Desk 的接入清单），本机未实测。开启前请先确认路径/进程名，否则只会空转。"
}