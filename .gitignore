# ---- 大文件 / 本地状态（绝不上传）----
# 注意：.gitignore 不支持行内注释，注释必须独立成行（踩过一次）
app/wb_usage/data/
# ccusage 采集缓存（npx 拉回来、含 fetched_at，运行期每次采集都变；可重建）
app/wb_usage/agents/data/ccusage/
app/.whale_settings.json
app/.whale_pos.json
app/wb_paths.json
*.db
*.db-wal
*.db-shm

# ---- Python ----
__pycache__/
*.pyc

# ---- 临时 / 测试残留 ----
app/tools/_tmp_*
_tmp_*
*.log

# ---- 诊断 / 预览截图（一次性产物，可重新生成）----
app/_preview_*.png
app/tools/_*.png

# ---- 生成式素材源图（不进仓库；可直接重新生成的中间产物）----
# README「素材与角色说明」声明仓库不含原始生成图 —— 这里保持这条口径。
# 成品（立绘 / 眨眼贴片）在 app/assets/pet_v3/，那才是运行期资产。
app/assets/_gen3/

# ---- Live2D 线（2026-09-26）----
# 只提交：脚本（app/tools/*live2d*、assemble/psd 相关）、交付文档、参考图、分层 PSD/ORA
# 其余一律不提交（都是可再生的中间物/第三方大件）
live2d/shell/node_modules/
live2d/shell/.pet-pos.json
live2d/vendor/
live2d/shell/models/
live2d/_work/
live2d/model/

# 备份文件（*.bak / *.bak_时间戳 / *.pre_*）不进仓库
*.bak
*.bak_*

# ---- Windows 打包产物（可随时重建，60MB+，绝不进仓库）----
# 提交的是 packaging/build_win.py + verify_win.py + app.ico；
# 产物由 `python packaging/build_win.py` 重新生成。
dist/
build/
